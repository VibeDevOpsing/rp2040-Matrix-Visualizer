# ==============================================================================
# Git Ignore for RP2040 Matrix Visualizer
# ==============================================================================

# macOS metadata & system files
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
__MACOSX/

# Windows system files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux system files
*~
.directory
.Trash-*

# Python & MicroPython bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.mpy
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.project
.pydevproject
.settings/

# Microcontroller & Board runtime artifacts
# (Auto-generated by CircuitPython / MicroPython filesystem on boot)
boot_out.txt
LOST.DIR/
sd/
settings.toml
.pio/
.pioenvs/
.circuitpy/

# Local logs and temporary files
*.log
*.tmp
*.bak
.cache/

# Local sensitive configuration
.env
.env.local
